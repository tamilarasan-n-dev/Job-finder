# Copy to .env on the VM and fill in. Never commit .env.
#   cp .env.example .env && nano .env

# ── SMTP ─────────────────────────────────────────────────────────────
# Google Cloud blocks outbound port 25 — use 587 (STARTTLS) or 465 (SSL).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
#        SMTP_PASS=<16-char App Password> (Google Account → Security → App passwords; needs 2-Step Verification)
SMTP_HOST=
SMTP_PORT=587
# true for port 465, false for 587. Leave empty to decide from the port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender shown in the inbox. Defaults to SMTP_USER.
MAIL_FROM="Job Finder <you@example.com>"

# ── Recipients ───────────────────────────────────────────────────────
# Main recipient(s) — comma-separated.
MAIL_TO=
# Silent copy (e.g. you, to see it's working). Comma-separated, optional.
MAIL_BCC=
# Gets failure alerts + the daily health check. Optional.
ADMIN_EMAIL=

# ── Schedule ─────────────────────────────────────────────────────────
# Cron syntax, in TZ. Default: every hour on the hour.
CRON_SCHEDULE=0 * * * *
TZ=Asia/Kolkata
# Run once immediately when the container starts.
RUN_ON_START=true
# Daily "still alive" summary to ADMIN_EMAIL (9:05 AM IST). Empty = off.
HEARTBEAT_CRON=5 9 * * *

# ── Tuning ───────────────────────────────────────────────────────────
# Cap per email; extra matches roll into the next run's email.
MAX_JOBS_PER_EMAIL=30
# Remote-job feeds (only India-eligible listings get through the filter).
FEED_REMOTIVE=true
FEED_REMOTEOK=true
FEED_WEWORKREMOTELY=true
# debug | info | warn | error
LOG_LEVEL=info
